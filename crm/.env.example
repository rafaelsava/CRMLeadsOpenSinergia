# Copie este archivo como .env y complete los valores. Lo usan el CRM, n8n (docker compose) y n8n/instalar.py.

# --- CRM ---
PORT=8080
CRM_TZ=America/Bogota
# APP_URL=https://crm.opensinergia.com    # para los enlaces en los correos de n8n y del resumen
# COOKIE_SECURE=1                         # activar cuando el CRM esté detrás de HTTPS
# TRUST_PROXY=1                           # activar si hay un proxy (Caddy/Nginx) delante

# --- n8n ---
# Token compartido entre n8n y el CRM. Genere uno largo, p. ej.: python3 -c "import secrets; print(secrets.token_urlsafe(32))"
N8N_API_TOKEN=
# Remitente fijo con el que llegan los correos del formulario web (lo dice Fermin).
N8N_FORM_SENDER=remitente-del-formulario@opensinergia.com
# Si n8n se publica con HTTPS:
# N8N_HOST=n8n.opensinergia.com
# N8N_PROTOCOL=https
# N8N_WEBHOOK_URL=https://n8n.opensinergia.com/

# --- Cuenta de Gmail de la empresa (n8n la usa para leer el formulario y enviar los correos) ---
GMAIL_USER=cuenta-de-la-empresa@gmail.com
# Contraseña de aplicación de 16 letras: myaccount.google.com > Seguridad > Contraseñas de aplicaciones
GMAIL_APP_PASSWORD=

# --- Correos para gerencia (resumen diario, aviso de lead nuevo y alertas de error) ---
SUMMARY_TO=cuenta-de-la-empresa@gmail.com
SUMMARY_FROM=cuenta-de-la-empresa@gmail.com
SUMMARY_HOUR=7

# --- Reglas de alerta ---
DUE_SOON_DAYS=3
STALE_LEAD_HOURS=48

# --- Alternativa sin n8n (el CRM lee Gmail y envía el resumen por sí mismo) ---
# Deje GMAIL_SEARCH vacío cuando use n8n.
# GMAIL_SEARCH=from:remitente-del-formulario@opensinergia.com
# GMAIL_POLL_MINUTES=5
# GMAIL_BACKFILL_DAYS=30
